---
import '../styles/global.css';
import { ui, localePath, asset, otherLocale, type Locale } from '../i18n/ui';
import spaceGroteskLatinFont from '../assets/fonts/space-grotesk-latin.woff2';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  paths?: Record<Locale, string>;
  markdownPath?: string;
}

const { lang } = Astro.props;
const t = ui[lang];
const other = otherLocale[lang];
const title = Astro.props.title ?? t.metaTitle;
const description = Astro.props.description ?? t.metaDescription;
const canonical = new URL(Astro.props.paths?.[lang] ?? localePath(lang), Astro.site).href;
const otherHref = new URL(Astro.props.paths?.[other] ?? localePath(other), Astro.site).href;
const defaultHref = new URL(Astro.props.paths?.en ?? localePath('en'), Astro.site).href;
const markdownHref = new URL(Astro.props.markdownPath ?? `${new URL(canonical).pathname.replace(/\/$/, '')}/index.md`, Astro.site).href;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#052023" />
    <link
      rel="preload"
      href={spaceGroteskLatinFont}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={t.htmlLang} href={canonical} />
    <link rel="alternate" hreflang={ui[other].htmlLang} href={otherHref} />
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    <link rel="alternate" type="text/markdown" href={markdownHref} />
    <link rel="describedby" href={new URL(import.meta.env.BASE_URL + 'llms.txt', Astro.site).href} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:url" content={canonical} />

    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
